{
  "name": "draftline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @draftline/server --filter @draftline/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test",
    "build:extension": "pnpm --filter @draftline/extension build",
    "start": "pnpm --parallel --filter @draftline/server --filter @draftline/web start"
  },
  "devDependencies": {
    "typescript": "~5.9"
  }
}
