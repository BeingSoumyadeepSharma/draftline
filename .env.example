# Optional. Every key here can also be set in the app, and a key saved in
# the app takes priority. Copy this file to .env to use it, then restart
# Draftline. Never commit .env: git ignores it.

# Claude, used when no AI provider is saved under AI settings.
ANTHROPIC_API_KEY=

# Position search (Discover tab). Free keys: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Adzuna searches one country at a time, as a two-letter code such as it, gb, us.
ADZUNA_COUNTRY=

# Web search for Greenhouse, Lever and Ashby postings: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
